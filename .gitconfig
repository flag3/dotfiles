[user]
	name = flag3
	email = flag3833753@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIOjQxWCDI767UzkyC8cRZPcXZFgHBsdvFuG7ub1NsZ5

[github]
	user = flag3

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.gitignore
	editor = nvim
	ignorecase = false
	pager = delta

[push]
	default = simple

[pull]
	rebase = false

[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
	ui = auto

[diff]
	tool = nvimdiff

[difftool "nvimdiff"]
	cmd = nvim -d "$LOCAL" "$REMOTE"
	path =

[mergetool "nvimdiff"]
	cmd = nvim -d "$LOCAL" "$REMOTE" -ancestor "$BASE" -merge "$MERGED"
	trustExitCode = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

[url "git@github.com:"]
	insteadOf = https://github.com/

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgsign = true

[include]
	path = ~/.config/git/aliases.gitconfig
	path = ~/.config/git/ghq.gitconfig
	path = ~/.config/git/delta.gitconfig
