{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail
export PATH="$HOME/.local/share/aquaproj-aqua/bin:/opt/homebrew/bin:$PATH"
eval "$(cd "$HOME" && mise env -s bash)" # aqua-proxy looks up aqua (from mise) on PATH

[ -f "$HOME/.venv/bin/activate.fish" ] || python -m venv "$HOME/.venv"

if [ ! -x "$HOME/.elan/bin/elan" ]; then
  curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --no-modify-path
fi
{{- end }}
