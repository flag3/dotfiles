{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# aqua.yaml hash: {{ include "dot_config/aquaproj-aqua/aqua.yaml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/share/aquaproj-aqua/bin:/opt/homebrew/bin:$PATH"

# mise installs aqua and language runtimes; aqua installs the remaining CLIs
cd "$HOME"
mise install
eval "$(mise env -s bash)"

cd "$HOME/.config/aquaproj-aqua"
aqua i -l

{{- end }}
